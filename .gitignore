# ==============================================================================
# IP Research Project Specific Ignores (Sensitive Data)
# ==============================================================================

# Ignore all patent datasets and reference pools
/data*/
/dataset*/
/ReferencePool*/
/Claims*/
dataset.zip



# Specifically ignore JSON files which contain the scraped patent content
*.json
!crawl_status.json
!config/*.json

# Ignore result files from experiments to avoid leaking data samples
results/
exp_results/
sft/
/analysis_output/

# Ignore any local configuration with API keys
config.yaml
config/local_config.yaml
config/secrets.yaml
.env

# Spider related bypass
spider/
spider.zip

# Optional utilities (not required for core pipeline)
# Keep repo clean: ignore most tools, whitelist a few referenced in README
tools/**


