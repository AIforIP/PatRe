### PatRe environment variables
### Copy this file to `.env` and fill in real values.

# Generation (OA / rebuttal generation)
OPENAI_API_KEY=YOUR_KEY
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1

# Judge (evaluation / scoring)
JUDGE_OPENAI_API_KEY=YOUR_KEY
JUDGE_OPENAI_BASE_URL=https://api.chatanywhere.tech/v1

# Optional: validate pipeline without real API calls
# PATRE_DRY_RUN=1
